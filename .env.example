# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chatmehere?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this

